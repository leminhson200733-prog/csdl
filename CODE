-- =============================================
-- 4. CAC CAU TRUY VAN
-- =============================================

-- 1. XEM DANH SACH DU AN
SELECT * FROM DuAn;

-- 2. DU AN VA CHU DAU TU, NHAN VIEN
SELECT DA.MaDA, DA.TenDA, CDT.TenCDT,
       NV.HoTen, DA.TongVon, DA.TrangThai
FROM DuAn DA
JOIN ChuDauTu CDT ON DA.MaCDT = CDT.MaCDT
JOIN NhanVien NV ON DA.MaNV = NV.MaNV;

-- 3. TIM KIEM DU AN
SELECT * FROM DuAn
WHERE TenDA LIKE N'%Green Park%';

-- 4. DANH SACH CONG TRINH
SELECT * FROM CongTrinh
WHERE TrangThai = N'Đang thi công';

-- 5. DEM SO CONG TRINH CUA MOI DU AN
SELECT DA.MaDA, DA.TenDA,
       COUNT(CT.MaCT) AS SoLuongCongTrinh
FROM DuAn DA
LEFT JOIN CongTrinh CT ON DA.MaDA = CT.MaDA
GROUP BY DA.MaDA, DA.TenDA;

-- 6. TONG GIA TRI HOP DONG MOI DU AN
SELECT DA.MaDA, DA.TenDA,
       ISNULL(SUM(HD.GiaTri), 0) AS TongGiaTriHopDong
FROM DuAn DA
LEFT JOIN HopDong HD ON DA.MaDA = HD.MaDA
GROUP BY DA.MaDA, DA.TenDA;

-- 7. THONG KE THANH TOAN
SELECT HD.MaHD, DA.TenDA, NT.TenNT,
       HD.GiaTri,
       ISNULL(SUM(TT.SoTien), 0) AS DaThanhToan,
       HD.GiaTri - ISNULL(SUM(TT.SoTien), 0)
           AS ConPhaiThanhToan
FROM HopDong HD
JOIN DuAn DA ON HD.MaDA = DA.MaDA
JOIN NhaThau NT ON HD.MaNT = NT.MaNT
LEFT JOIN ThanhToan TT ON HD.MaHD = TT.MaHD
GROUP BY HD.MaHD, DA.TenDA, NT.TenNT, HD.GiaTri;

-- 8. CHI PHI VAT TU MOI CONG TRINH
SELECT CT.TenCT,
       SUM(CTVT.SoLuong * VT.DonGia) AS TongChiPhi
FROM CongTrinh CT
JOIN ChiTietVatTu CTVT ON CT.MaCT = CTVT.MaCT
JOIN VatTu VT ON CTVT.MaVT = VT.MaVT
GROUP BY CT.MaCT, CT.TenCT;

-- 9. TIEN DO MOI NHAT CUA CONG TRINH
WITH TienDoMoiNhat AS (
    SELECT *,
       ROW_NUMBER() OVER (
           PARTITION BY MaCT
           ORDER BY NgayCapNhat DESC, MaTD DESC
       ) AS STT
    FROM TienDo
)
SELECT CT.TenCT, TD.NgayCapNhat,
       TD.PhanTram, TD.GhiChu
FROM CongTrinh CT
LEFT JOIN TienDoMoiNhat TD
ON CT.MaCT = TD.MaCT AND TD.STT = 1;

