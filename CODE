-- 1. TAO DATABASE
CREATE DATABASE QuanLyDuAnXayDung;
GO

USE QuanLyDuAnXayDung;
GO

-- =============================================
-- 2. TAO CAC BANG
-- =============================================

-- BANG CHU DAU TU
CREATE TABLE ChuDauTu (
    MaCDT INT IDENTITY(1,1) PRIMARY KEY,
    TenCDT NVARCHAR(100) NOT NULL,
    DiaChi NVARCHAR(200),
    SoDienThoai VARCHAR(15) UNIQUE
);

-- BANG NHAN VIEN
CREATE TABLE NhanVien (
    MaNV INT IDENTITY(1,1) PRIMARY KEY,
    HoTen NVARCHAR(100) NOT NULL,
    NgaySinh DATE,
    GioiTinh NVARCHAR(10),
    ChucVu NVARCHAR(50),
    Luong DECIMAL(18,2) CHECK (Luong >= 0)
);

-- BANG DU AN
CREATE TABLE DuAn (
    MaDA INT IDENTITY(1,1) PRIMARY KEY,
    TenDA NVARCHAR(150) NOT NULL,
    MaCDT INT NOT NULL,
    MaNV INT NOT NULL,
    NgayBatDau DATE NOT NULL,
    NgayKetThuc DATE,
    TongVon DECIMAL(18,2) CHECK (TongVon >= 0),
    TrangThai NVARCHAR(50) DEFAULT N'Dang thuc hien',

    FOREIGN KEY (MaCDT) REFERENCES ChuDauTu(MaCDT),
    FOREIGN KEY (MaNV) REFERENCES NhanVien(MaNV),

    CHECK (NgayKetThuc IS NULL OR NgayKetThuc >= NgayBatDau)
);

-- BANG CONG TRINH
CREATE TABLE CongTrinh (
    MaCT INT IDENTITY(1,1) PRIMARY KEY,
    MaDA INT NOT NULL,
    TenCT NVARCHAR(150) NOT NULL,
    DiaDiem NVARCHAR(200),
    NgayBatDau DATE,
    NgayKetThuc DATE,
    TrangThai NVARCHAR(50) DEFAULT N'Dang thi cong',

    FOREIGN KEY (MaDA) REFERENCES DuAn(MaDA),
    CHECK (
        NgayKetThuc IS NULL OR NgayBatDau IS NULL
        OR NgayKetThuc >= NgayBatDau
    )
);

-- BANG NHA THAU
CREATE TABLE NhaThau (
    MaNT INT IDENTITY(1,1) PRIMARY KEY,
    TenNT NVARCHAR(100) NOT NULL,
    DiaChi NVARCHAR(200),
    SoDienThoai VARCHAR(15) UNIQUE,
    Email VARCHAR(100)
);

-- BANG HOP DONG
CREATE TABLE HopDong (
    MaHD INT IDENTITY(1,1) PRIMARY KEY,
    MaDA INT NOT NULL,
    MaNT INT NOT NULL,
    NgayKy DATE NOT NULL,
    GiaTri DECIMAL(18,2) NOT NULL CHECK (GiaTri > 0),
    NoiDung NVARCHAR(300),

    FOREIGN KEY (MaDA) REFERENCES DuAn(MaDA),
    FOREIGN KEY (MaNT) REFERENCES NhaThau(MaNT)
);

-- BANG VAT TU
CREATE TABLE VatTu (
    MaVT INT IDENTITY(1,1) PRIMARY KEY,
    TenVT NVARCHAR(100) NOT NULL,
    DonViTinh NVARCHAR(30),
    DonGia DECIMAL(18,2) CHECK (DonGia >= 0)
);

-- BANG CHI TIET VAT TU
CREATE TABLE ChiTietVatTu (
    MaCT INT NOT NULL,
    MaVT INT NOT NULL,
    SoLuong DECIMAL(18,2) NOT NULL CHECK (SoLuong > 0),

    PRIMARY KEY (MaCT, MaVT),
    FOREIGN KEY (MaCT) REFERENCES CongTrinh(MaCT),
    FOREIGN KEY (MaVT) REFERENCES VatTu(MaVT)
);

-- BANG TIEN DO
CREATE TABLE TienDo (
    MaTD INT IDENTITY(1,1) PRIMARY KEY,
    MaCT INT NOT NULL,
    NgayCapNhat DATE NOT NULL,
    PhanTram DECIMAL(5,2) NOT NULL
        CHECK (PhanTram BETWEEN 0 AND 100),
    GhiChu NVARCHAR(300),

    FOREIGN KEY (MaCT) REFERENCES CongTrinh(MaCT)
);

-- BANG THANH TOAN
CREATE TABLE ThanhToan (
    MaTT INT IDENTITY(1,1) PRIMARY KEY,
    MaHD INT NOT NULL,
    NgayThanhToan DATE NOT NULL,
    SoTien DECIMAL(18,2) NOT NULL CHECK (SoTien > 0),
    PhuongThuc NVARCHAR(50),
    GhiChu NVARCHAR(200),

    FOREIGN KEY (MaHD) REFERENCES HopDong(MaHD)
);
GO

