-- =============================================
-- 6. TRIGGER KIEM TRA THANH TOAN
-- =============================================

CREATE TRIGGER TRG_KiemTraThanhToan
ON ThanhToan
AFTER INSERT, UPDATE
AS
BEGIN
    SET NOCOUNT ON;

    IF EXISTS (
        SELECT 1
        FROM HopDong HD
        WHERE HD.GiaTri < (
            SELECT SUM(TT.SoTien)
            FROM ThanhToan TT
            WHERE TT.MaHD = HD.MaHD
        )
    )
    BEGIN
        ROLLBACK TRANSACTION;
        THROW 50001,
        N'Tổng thanh toán vượt giá trị hợp đồng!', 1;
    END
END;
GO

